DATABASE_URL=postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres
# O painel lê estas duas de painel/.env.local (copie as linhas para lá). Na Vercel, cadastre as duas no projeto.
NEXT_PUBLIC_SUPABASE_URL=https://PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# Pelo menos 32 caracteres, igual ao valor gravado em app.chave_assinatura_consulta. Só no servidor.
ASSISTENTE_CHAVE_ASSINATURA=
TENANT_DEMO_ID=11111111-1111-1111-1111-111111111111

# ERP de origem (usuario de API da base de testes; nunca commitar o .env)
# Base do subdominio, sem /public/api/v1: a carga e o cadastro de webhooks acrescentam o caminho. So https
ORIGEM_URL_BASE=
ORIGEM_TENANT=
ORIGEM_CLIENT_ID=
ORIGEM_CLIENT_SECRET=
# basic (usuario de API criado pelo admin do cliente, como na documentacao publica) ou oauth (as quatro de cima)
ORIGEM_AUTENTICACAO=basic
ORIGEM_USUARIO=
ORIGEM_SENHA=
# Limites por minuto por subdominio; o cliente divide com as outras integracoes, entao fica abaixo do teto
ORIGEM_LIMITE_REST_MINUTO=200
ORIGEM_LIMITE_BULK_MINUTO=20
# Teto de chamadas por execucao: pacote do cliente menos o que as outras integracoes ja consomem no dia
ORIGEM_COTA_DIARIA=1000
# Bulk: 600 no menor pacote que tem Bulk, 28800 no Ultimate; abaixo do plano a carga para sempre na mesma tarefa
ORIGEM_COTA_DIARIA_BULK=600
ORIGEM_TIMEOUT_SEGUNDOS=60
ORIGEM_JANELA_INICIAL_DIAS=400
ORIGEM_HORIZONTE_DIAS=3650
ORIGEM_DIAS_PAGAMENTO=7
# Codigo do indexador de correcao que o a pagar (outcome) exige; ver na sondagem
ORIGEM_INDEXADOR_CORRECAO=
ORIGEM_REVERIFICAR_BULK_DIAS=30

# CRM de vendas, opcional por tenant: vazio desliga a carga. Usuario de integracao do cliente, so na carga, nunca na Vercel
CRM_URL_BASE=
CRM_EMAIL=
CRM_TOKEN=
CRM_LIMITE_POR_MINUTO=30
