DATABASE_URL=postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres
# O painel lê estas duas de painel/.env.local (copie as linhas para lá). Na Vercel, cadastre as duas no projeto.
NEXT_PUBLIC_SUPABASE_URL=https://PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# Pelo menos 32 caracteres, igual ao valor gravado em app.chave_assinatura_consulta. Só no servidor.
ASSISTENTE_CHAVE_ASSINATURA=
# Limites do assistente (30 perguntas por hora por usuario, US$ 5 por dia por construtora) ficam na
# tabela app.parametro_assistente, linha unica, editada pelo SQL Editor; nao ha variavel para eles.
# Segredo que o monitor de disponibilidade manda em x-monitor-token para /api/saude devolver commit e
# situacao da carga; sem ele a rota responde so ok e idade. Só no servidor.
MONITOR_TOKEN=
# 1 mostra o aviso "Dados da demo" em toda tela; so no projeto da demo, nunca no piloto.
NEXT_PUBLIC_MOSTRAR_AVISO_DEMO=
# 1 coloca o painel em manutencao: as telas respondem 503 com o aviso e a API, 503 em JSON; /api/saude segue
# no ar. Use durante migration que muda contrato. Na Vercel, mudar o valor pede um Redeploy. So no servidor.
MODO_MANUTENCAO=
TENANT_DEMO_ID=11111111-1111-1111-1111-111111111111

# ERP de origem (usuario de API da base de testes; nunca commitar o .env)
# Base do subdominio, sem /public/api/v1: a carga e o cadastro de webhooks acrescentam o caminho. So https
ORIGEM_URL_BASE=
ORIGEM_TENANT=
ORIGEM_CLIENT_ID=
ORIGEM_CLIENT_SECRET=
# basic (usuario de API criado pelo admin do cliente, como na documentacao publica) ou oauth (as quatro de cima)
ORIGEM_AUTENTICACAO=basic
ORIGEM_USUARIO=
ORIGEM_SENHA=
# Rota do Bulk no gateway v2 (oauth). A sondagem de 11/10/2026 recebeu 404 em group/v2/bulk-data/v1;
# confirme a rota com o ERP e ajuste aqui. Sem Bulk a carga segue pelo caminho so REST
ORIGEM_CAMINHO_BULK=group/v2/bulk-data/v1

# O resto da configuracao da carga (limites por minuto, cotas, timeout, janela, horizonte, dias de pagamento,
# indexador de correcao, reverificacao do Bulk, limites da fila, inicio contabil e empresas contabeis) mora em
# app.origem_configuracao, uma linha por cliente, gravada por scripts/cadastrar_cliente.py (migration 0043,
# ADR 0022). As variaveis ORIGEM_* abaixo so valem com a chave ligada, para teste local; sem ela a carga
# ignora o valor e avisa no log. Deixe vazio em producao.
ORIGEM_SOBRESCREVER_CONFIGURACAO=
# ORIGEM_LIMITE_REST_MINUTO, ORIGEM_LIMITE_BULK_MINUTO, ORIGEM_COTA_DIARIA, ORIGEM_COTA_DIARIA_BULK,
# ORIGEM_TIMEOUT_SEGUNDOS, ORIGEM_JANELA_INICIAL_DIAS, ORIGEM_HORIZONTE_DIAS, ORIGEM_DIAS_PAGAMENTO,
# ORIGEM_INDEXADOR_CORRECAO, ORIGEM_REVERIFICAR_BULK_DIAS, ORIGEM_FILA_LIMITE_REST, ORIGEM_FILA_LIMITE_BULK,
# ORIGEM_INICIO_CONTABIL (aaaa-mm), ORIGEM_EMPRESAS_CONTABEIS (codigos separados por virgula)

# CRM de vendas, opcional por tenant: vazio desliga a carga. Usuario de integracao do cliente, so na carga, nunca na Vercel
CRM_URL_BASE=
CRM_EMAIL=
CRM_TOKEN=
CRM_LIMITE_POR_MINUTO=30
